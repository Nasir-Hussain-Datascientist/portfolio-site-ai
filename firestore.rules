rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- ENTITY VALIDATIONS ---

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'category', 'thumbnail']) &&
             data.title is string && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.thumbnail is string && data.thumbnail.size() <= 2000;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidCertification(data) {
      return data.keys().hasAll(['title', 'organization']) &&
             data.title is string && data.title.size() <= 200 &&
             data.organization is string && data.organization.size() <= 200;
    }

    function isValidBlog(data) {
      return data.keys().hasAll(['title', 'slug', 'content']) &&
             data.title is string && data.title.size() <= 200 &&
             data.slug is string && data.slug.size() <= 200 &&
             data.content is string && data.content.size() <= 100000;
    }

    function isValidService(data) {
      return data.keys().hasAll(['title', 'description']) &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000;
    }

    function isValidSettings(data) {
      return data.get('name', '') is string &&
             data.get('role', '') is string &&
             data.get('email', '') is string;
    }

    // --- COLLECTIONS ---

    match /test/connection {
      allow get: if true;
    }

    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }

    match /certifications/{certId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow get: if true;
      allow list: if true; // In production blogs might be filtered by 'published' but we allow list for simplicity if public
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
