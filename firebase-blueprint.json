{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A portfolio project showcasing work",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "fullDescription": { "type": "string" },
        "technologies": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "thumbnail": { "type": "string" },
        "liveUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "embedUrl": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "thumbnail"]
    },
    "Category": {
      "title": "Category",
      "description": "Project category",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "count": { "type": "number" }
      },
      "required": ["name"]
    },
    "Certification": {
      "title": "Certification",
      "description": "Professional certification",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "organization": { "type": "string" },
        "issueDate": { "type": "string" },
        "image": { "type": "string" },
        "verificationUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "organization"]
    },
    "Blog": {
      "title": "Blog",
      "description": "Blog post",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "metaDescription": { "type": "string" },
        "content": { "type": "string" },
        "featuredImage": { "type": "string" },
        "author": { "type": "string" },
        "published": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "content"]
    },
    "Service": {
      "title": "Service",
      "description": "Service offered",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "iconName": { "type": "string" },
        "description": { "type": "string" },
        "benefits": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "description"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global portfolio settings",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "linkedin": { "type": "string" },
        "github": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "tiktok": { "type": "string" },
        "facebook": { "type": "string" },
        "bio": { "type": "string" },
        "profilePhotoUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "projects": { "schema": "Project", "description": "Portfolio projects" },
    "categories": { "schema": "Category", "description": "Project categories" },
    "certifications": { "schema": "Certification", "description": "Certifications and awards" },
    "blogs": { "schema": "Blog", "description": "Blog posts" },
    "services": { "schema": "Service", "description": "Services offered" },
    "settings": { "schema": "Settings", "description": "Global settings" }
  }
}
